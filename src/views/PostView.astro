---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG, type Locale } from "@/config";
import { formatDate, localizePath, t } from "@/i18n";
import { getPostAlternates, postReadingTime, type Post } from "@/utils/content";
import { cardPath } from "@/utils/social-card";
import ArticleAnimate from "@/components/ui/ArticleAnimate";
import FadeContent from "@/components/ui/FadeContent";
import ScrollFloat from "@/components/ui/ScrollFloat";
import MDXImage from "@/components/blog/MDXImage.astro";
import TableOfContents from "@/components/blog/TableOfContents.astro";
import ShareButton from "@/components/share/ShareButton";
import { RiArrowLeftDoubleLine, RiArrowRightDoubleLine } from "@remixicon/react";
import "katex/dist/katex.min.css";

interface Props {
    locale: Locale;
    post: Post;
    /** Newer article of the same language. */
    nextPost: Post | null;
    /** Older article of the same language. */
    prevPost: Post | null;
}

const { locale, post, nextPost, prevPost } = Astro.props;
const entry = post.entry;
const { Content, headings } = await render(entry);

const alternates = await getPostAlternates(post);
const origin = Astro.site ?? new URL(SITE_CONFIG.site);
const absolute = (path: string) => new URL(path, origin).toString();
const readingTime = postReadingTime(post, locale);

// Copyright settings: article frontmatter > global config
const copyright = {
    enabled: entry.data.copyright?.enabled ?? SITE_CONFIG.articleCopyright.enabled,
    declaration: entry.data.copyright?.declaration ?? SITE_CONFIG.articleCopyright.declaration[locale],
    author: entry.data.author ?? SITE_CONFIG.author,
};
---

<Layout
    locale={locale}
    title={`${entry.data.title} // ${SITE_CONFIG.title[locale]}`}
    description={entry.data.description}
    alternates={alternates}
    type="article"
    image={cardPath(locale, post.slug, "og")}
    imageAlt={entry.data.title}
    publishDate={entry.data.pubDate}
    modifiedDate={entry.data.updatedDate}
    authorName={entry.data.author}
    tags={entry.data.tags}
>
    <script
        type="application/ld+json"
        set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": t(locale, "nav.home"),
                    "item": absolute(localizePath(locale, "/"))
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": t(locale, "nav.blog"),
                    "item": absolute(localizePath(locale, "/blog/"))
                },
                {
                    "@type": "ListItem",
                    "position": 3,
                    "name": entry.data.title,
                    "item": absolute(post.path)
                }
            ]
        })}
    />
    <article
        class="w-full min-w-0 max-w-3xl mx-auto pt-4 md:pt-6 relative"
        data-pagefind-body
        data-pagefind-meta="kind:blog"
    >
        <TableOfContents headings={headings} locale={locale} />

        {/* Content Area */}
        <div class="w-full">
            <header
                class="mb-12 text-left"
            >

                <h1
                    class="text-2xl md:text-4xl font-bold tracking-tight leading-tight mb-8"
                >
                    <ScrollFloat
                        client:load
                        text={entry.data.title}
                        className="text-2xl md:text-4xl font-bold tracking-tight leading-tight"
                        scrollStart="top bottom"
                        scrollEnd="top center+=200"
                        stagger={0.02}
                    />
                </h1>

                <FadeContent
                    client:load
                    delay={300}
                    duration={800}
                    blur={true}
                >
                    <p
                        class="text-sm sm:text-base text-secondary-text/80 leading-relaxed"
                    >
                        {
                            entry
                                .data
                                .description
                        }
                    </p>
                    <div class="flex items-center justify-between text-[11px] sm:text-xs font-mono text-secondary-text mt-4 opacity-60 dark:opacity-85">
                        <span>{formatDate(entry.data.pubDate, locale)}</span>
                        <div class="flex items-center gap-3">
                            <span class="uppercase tracking-wider text-accent font-semibold">{entry.data.category}</span>
                            {entry.data.depth && (
                                <>
                                    <span class="opacity-40">•</span>
                                    <span class="uppercase tracking-wider">{entry.data.depth}</span>
                                </>
                            )}
                        </div>
                    </div>
                    <div class="flex items-center justify-between gap-4 text-[11px] sm:text-xs font-mono text-secondary-text mt-3">
                        <span class="opacity-60 dark:opacity-85">{readingTime}</span>
                        <ShareButton
                            client:idle
                            locale={locale}
                            title={entry.data.title}
                            url={absolute(post.path)}
                            storyImage={cardPath(locale, post.slug, "story")}
                            storyImageDark={cardPath(locale, post.slug, "story-dark")}
                            filename={`${locale}-${post.slug}`}
                        />
                    </div>
                </FadeContent>
            </header>

            <ArticleAnimate
                client:load
                className="prose dark:prose-invert max-w-none prose-headings:font-sans prose-headings:font-bold prose-headings:tracking-tight prose-a:text-black dark:prose-a:text-white prose-a:underline prose-a:decoration-1 prose-a:underline-offset-4 prose-blockquote:not-italic prose-blockquote:border-l-2 prose-blockquote:pl-6 prose-blockquote:border-black/20 dark:prose-blockquote:border-white/20"
            >
                {entry.data.cover && <MDXImage src={entry.data.cover} alt={entry.data.coverAlt ?? ""} />}
                <Content
                    components={{
                        img: MDXImage,
                    }}
                />

                {
                    /* Tags */
                }
                {
                    entry.data.tags &&
                        entry.data.tags.length > 0 && (
                            <div class="mt-12 flex flex-wrap gap-2 not-prose">
                                {entry.data.tags.map((tag: string) => (
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-black/[0.04] dark:bg-white/[0.08] hover:dark:bg-white/[0.12] rounded-full text-xs font-mono text-secondary-text dark:text-zinc-200 border border-black/5 dark:border-white/10 transition-colors">
                                        <span class="text-secondary-text/50 dark:text-zinc-400">#</span>
                                        <span class="font-medium tracking-wide">{tag}</span>
                                    </span>
                                ))}
                            </div>
                        )
                }

                {
                    /* Copyright Declaration (Pure Typography Minimalist) */
                }
                {
                    copyright.enabled && (
                        <div class="mt-20 pt-8 border-t border-black/10 dark:border-white/10 not-prose">
                            <div class="flex flex-col gap-3">
                                <span class="text-[11px] font-mono uppercase tracking-widest text-primary-text opacity-40">
                                    {t(locale, "post.copyright")}
                                </span>
                                <div class="flex flex-col gap-1.5 text-[15px] font-sans text-primary-text">
                                    <p class="opacity-90 font-light">
                                        &copy; {entry.data.pubDate.getUTCFullYear()} <span class="font-medium">{copyright.author}</span>
                                    </p>
                                    <p class="opacity-60 text-sm font-light max-w-2xl leading-relaxed">{copyright.declaration}</p>
                                </div>
                            </div>
                        </div>
                    )
                }
            </ArticleAnimate>

            {
                /* Footer / Signature */
            }
            <footer
                class="mt-16 pt-12 border-t border-black/5 dark:border-white/5 space-y-12"
            >
                {
                    /* Navigation Links */
                }
                <div
                    class="flex flex-col sm:flex-row justify-between gap-6"
                >
                    <div
                        class="flex-1 text-left"
                    >
                        {
                            nextPost && (
                                <a
                                    href={nextPost.path}
                                    class="group block"
                                >
                                    <span class="text-xs font-mono uppercase tracking-widest opacity-60 dark:opacity-80 flex items-center gap-1.5 mb-2 group-hover:opacity-100 transition-opacity">
                                        <RiArrowLeftDoubleLine className="w-3.5 h-3.5 transition-transform duration-300 group-hover:-translate-x-0.5" />
                                        <span>{t(locale, "post.nextPost")}</span>
                                    </span>
                                    <span class="text-lg font-bold group-hover:underline">
                                        {nextPost.entry.data.title}
                                    </span>
                                </a>
                            )
                        }
                    </div>
                    <div
                        class="flex-1 text-right"
                    >
                        {
                            prevPost && (
                                <a
                                    href={prevPost.path}
                                    class="group block"
                                >
                                    <span class="text-xs font-mono uppercase tracking-widest opacity-60 dark:opacity-80 flex items-center justify-end gap-1.5 mb-2 group-hover:opacity-100 transition-opacity">
                                        <span>{t(locale, "post.previousPost")}</span>
                                        <RiArrowRightDoubleLine className="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5" />
                                    </span>
                                    <span class="text-lg font-bold group-hover:underline">
                                        {prevPost.entry.data.title}
                                    </span>
                                </a>
                            )
                        }
                    </div>
                </div>
            </footer>
        </div>
    </article>
</Layout>



<script>
    function setupTOC() {
        const toc = document.querySelector('.toc-container');
        const backToTopBtn = document.getElementById('back-to-top-btn');

        if (backToTopBtn) {
            backToTopBtn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        if (!toc) return;

        // Clean up previous event listener if it exists to prevent memory leaks during SPA navigations
        if ((window as any)._tocScrollListener) {
            window.removeEventListener('scroll', (window as any)._tocScrollListener);
        }

        const handleScroll = () => {
            const isScrolled = window.scrollY > 220;
            if (isScrolled) toc.classList.add('is-scrolled');
            else toc.classList.remove('is-scrolled');
        };

        (window as any)._tocScrollListener = handleScroll;
        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll(); // Initial execution
    }

    // Initialize on page load
    setupTOC();
    // Re-initialize after view transitions
    document.addEventListener('astro:after-swap', setupTOC);
</script>

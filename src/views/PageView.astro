---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG, type Locale } from "@/config";
import { getPageAlternates, type Page } from "@/utils/content";
import TextReveal from "@/components/ui/TextReveal";
import ArticleAnimate from "@/components/ui/ArticleAnimate";
import FadeContent from "@/components/ui/FadeContent";
import MDXImage from "@/components/blog/MDXImage.astro";
import "katex/dist/katex.min.css";

interface Props {
    locale: Locale;
    page: Page;
}

const { locale, page } = Astro.props;
const entry = page.entry;
const { Content } = await render(entry);
const alternates = await getPageAlternates(page);
---

<Layout
    locale={locale}
    title={`${entry.data.title} // ${SITE_CONFIG.title[locale]}`}
    description={entry.data.description || `${entry.data.title} - ${SITE_CONFIG.title[locale]}`}
    alternates={alternates}
>
    <article class="w-full min-w-0 max-w-3xl mx-auto pt-4 md:pt-6" data-pagefind-body data-pagefind-meta="kind:about">
        <header class="mb-12 text-left">
            <TextReveal
                client:load
                text={entry.data.title}
                type="char"
                className="text-2xl md:text-4xl font-bold tracking-tight leading-tight mb-8"
            />

            {entry.data.description && (
                <FadeContent
                    client:load
                    delay={
                        200
                    }
                    duration={
                        700
                    }
                    blur={
                        true
                    }
                >
                    <p class="text-lg md:text-xl text-primary-text text-left leading-[1.75] md:leading-[1.7]">
                        {
                            entry
                                .data
                                .description
                        }
                    </p>
                </FadeContent>
            )}
        </header>

        <ArticleAnimate
            client:load
            className="prose dark:prose-invert max-w-none prose-headings:font-sans prose-headings:font-bold prose-headings:tracking-tight prose-a:text-black dark:prose-a:text-white prose-a:underline prose-a:decoration-1 prose-a:underline-offset-4"
        >
            <Content components={{ img: MDXImage }} />
        </ArticleAnimate>
    </article>
</Layout>

---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BlogIndexView from "@/views/BlogIndexView.astro";
import { blogIndexPaths } from "@/utils/routes";

export const getStaticPaths = (({ paginate }) => blogIndexPaths("en", paginate)) satisfies GetStaticPaths;

const { page } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
---

<BlogIndexView locale="en" page={page} />

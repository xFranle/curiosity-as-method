---
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";
import { localizePath, t } from "@/i18n";
import MotionWrapper from "@/components/ui/MotionWrapper";
import TextReveal from "@/components/ui/TextReveal";
---

<!--
    GitHub Pages serves one 404.html for the whole site, so this page cannot know the
    visitor's language from the URL. It is written in both languages.
-->
<Layout locale="en" title={`404 // ${SITE_CONFIG.title.en}`} description={t("en", "notFound.body")} noindex>
    <!-- Background Watermark -->
    <div
        class="fixed top-0 right-0 h-screen z-[-10] select-none pointer-events-none overflow-hidden flex items-center justify-center"
    >
        <TextReveal
            client:load
            text="404"
            type="char"
            className="font-bold text-black/[0.03] dark:text-white/[0.15] text-[18vh] lg:text-[25vh] leading-none whitespace-nowrap"
            style={{
                writingMode:
                    "vertical-rl",
                textOrientation:
                    "mixed",
            }}
        />
    </div>

    <!-- Main Content -->
    <section
        class="w-full flex flex-col items-center justify-center text-center min-h-[60vh]"
    >
        <MotionWrapper
            client:idle
            delay={0.1}
            className="w-full max-w-3xl px-6"
        >
            <!-- Heading -->
            <h1
                class="text-6xl md:text-8xl font-bold tracking-tighter mb-6 text-primary-text dark:text-primary-text-dark leading-tight"
            >
                {t("en", "notFound.title")}
            </h1>

            <!-- Subtitle -->
            <p class="text-xl md:text-2xl text-secondary-text font-light italic">{t("en", "notFound.body")}</p>
            <p lang="es" class="mt-3 text-base md:text-lg text-secondary-text font-light italic opacity-70">
                {t("es", "notFound.title")}. {t("es", "notFound.body")}.
            </p>
            <nav class="mt-10 flex items-center justify-center gap-6 font-mono text-xs uppercase tracking-widest">
                <a href={localizePath("en", "/")} class="hover:underline">{t("en", "notFound.home")}</a>
                <span class="opacity-30">/</span>
                <a href={localizePath("es", "/")} lang="es" class="hover:underline">{t("es", "notFound.home")}</a>
            </nav>
        </MotionWrapper>
    </section>
</Layout>
